# Settings for the Sign in with GitHub function. Copy to .env.local for `npm run dev:api`;
# on Vercel, set them under Project → Settings → Environment Variables. Never commit real values.

# From your GitHub App's settings page (General → About).
GH_CLIENT_ID=
# GitHub App → General → Client secrets → Generate a new client secret.
GH_CLIENT_SECRET=
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Exact origin the app is served from. Locally: http://localhost:4200
APP_ORIGIN=http://localhost:4200
